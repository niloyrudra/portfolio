# Block all direct HTTP access to this directory.
# data/auth.json, data/content.json, data/messages.json must NEVER be
# served as static files — they are read only by the Node.js process.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
